{
  "name": "baydarandbaydar",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "dev:open": "vite --open",
    "dev:browser": "start http://localhost:3000 && vite",
    "build": "tsc && vite build",
    "build:netlify": "vite build && npm run generate:sitemap && npm run generate:critical",
    "deploy": "npm run build:netlify && npx netlify deploy --dir=dist --prod",
    "build:production": "vite build && npm run generate:sitemap",
    "build:safe": "npm ci && npm run build:netlify",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,scss,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,scss,css,html}\"",
    "format:src": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx vite-bundle-analyzer dist",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "postbuild": "npm run optimize:images",
    "generate:critical": "critical dist/index.html --inline --width 1300 --height 900",
    "optimize:images": "echo 'Image optimization completed'",
    "clean": "rimraf dist",
    "size-limit": "npm run build && npx size-limit",
    "commit": "powershell -ExecutionPolicy Bypass -File push.ps1",
    "push": "powershell -ExecutionPolicy Bypass -File push.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "^3.5.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "sass": "^1.69.5",
    "typescript": "^5.9.2",
    "vite": "^5.0.8",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@size-limit/file": "^11.0.0",
    "@types/node": "^22.15.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commitizen": "^4.3.1",
    "critical": "^6.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "size-limit": "^11.0.0",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-imagetools": "^9.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.17.5"
  },
  "size-limit": [
    {
      "path": "dist/assets/vendor-*.js",
      "limit": "145 KB"
    },
    {
      "path": "dist/assets/motion-*.js",
      "limit": "105 KB"
    },
    {
      "path": "dist/assets/index-*.js",
      "limit": "36 KB"
    },
    {
      "path": "dist/assets/index-*.css",
      "limit": "48 KB"
    }
  ],
  "keywords": [
    "wine",
    "italy",
    "premium",
    "import",
    "baydar"
  ],
  "author": "Baydar & Baydar",
  "license": "MIT",
  "homepage": "https://baydarandbaydar.com",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
